# ---------------------------------------------------------------------------
# OpsMind AI - environment
# Every service degrades to MOCK MODE when its key is absent, so the whole
# stack boots and demos with zero credentials.
# ---------------------------------------------------------------------------
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# Gemini (Core AI + embeddings + vision)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004

# MongoDB (operational data)
MONGO_URI=
MONGO_DB=opsmind

# Supabase (pgvector store for RAG)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DOCS_TABLE=policy_chunks

# Celery / Redis
REDIS_URL=redis://localhost:6379/0

# Firebase Auth (bearer verification). Leave blank to allow dev tokens.
FIREBASE_CREDENTIALS_JSON=
AUTH_DEV_BYPASS=true

# n8n
N8N_WEBHOOK_URL=

# RAG tuning
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MIN_SCORE=0.25
